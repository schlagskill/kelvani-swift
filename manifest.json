{
  "manifest_version": 3,
  "name": "KelvaniSwift",
  "description": "Arbeitsbereiche für Browser-Tabs. Lokal sichern, wiederfinden und kontrolliert öffnen.",
  "version": "0.2.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "KelvaniSwift öffnen"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
